rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{articleId} {
      allow get, list: if request.auth != null || resource.data.status == 'PUBLISHED';
      allow create: if request.auth != null
        && request.resource.data.id == articleId
        && request.resource.data.slug == articleId;
      allow update: if request.auth != null
        && request.resource.data.id == resource.data.id
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null;
    }

    match /contactMessages/{messageId} {
      function validStatus(status) {
        return status in ['NEW', 'IN_PROGRESS', 'DONE'];
      }
      function validMessage(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.name.matches('.*[^ ].*')
          && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
          && data.email.matches('^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
          && data.message is string && data.message.size() >= 10 && data.message.size() <= 4000
          && data.message.matches('.*[^ ].*')
          && data.locale in ['en', 'id']
          && data.sourcePath is string && data.sourcePath.size() > 0 && data.sourcePath.size() <= 200
          && data.sourcePath.matches('^/[^?#]*$')
          && validStatus(data.status)
          && data.adminNote is string && data.adminNote.size() <= 2000;
      }
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'message', 'locale', 'sourcePath', 'status',
          'adminNote', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'message', 'locale', 'sourcePath', 'status',
          'adminNote', 'createdAt', 'updatedAt'
        ])
        && validMessage(request.resource.data)
        && request.resource.data.status == 'NEW'
        && request.resource.data.adminNote == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get, list: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminNote', 'updatedAt'
        ])
        && validMessage(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null;
    }
  }
}
