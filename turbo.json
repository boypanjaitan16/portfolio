{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
		"dev": { "cache": false, "persistent": true },
		"lint": { "outputs": [] },
		"format": { "cache": false, "outputs": [] },
		"format:check": { "outputs": [] },
		"test": { "outputs": [] },
		"test:coverage": { "outputs": ["coverage/**"] }
	}
}
