{
	"name": "portfolio",
	"version": "1.0.0",
	"description": "Personal portfolio and tools workspace.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo run dev --parallel",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"test:pages:smoke": "firebase emulators:exec --project demo-portfolio --only firestore,storage 'bash scripts/test-pages-smoke.sh'"
	},
	"author": "Boy Boni Panjaitan",
	"license": "ISC",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.11.0",
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"turbo": "^2.3.3"
	}
}
