{
	"name": "@portfolio/tools",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome check --linter-enabled=false --assist-enabled=false .",
		"test": "vitest run --maxWorkers=2",
		"test:coverage": "vitest run --coverage",
		"build:pages": "tsc -b && vite build && node scripts/prerender.mjs"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@fontsource-variable/instrument-sans": "^5.2.7",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@pdf-lib/fontkit": "^1.1.1",
		"@portfolio/config": "workspace:*",
		"@tanstack/react-query": "^5.104.0",
		"lucide-react": "^0.468.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.3.289",
		"qrcode": "^1.5.4",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.12.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.10.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"@vitest/coverage-v8": "^4.0.18",
		"autoprefixer": "^10.4.23",
		"jsdom": "^27.4.0",
		"jsqr": "^1.4.0",
		"postcss": "^8.5.6",
		"puppeteer": "^25.12.0",
		"tailwindcss": "^3.4.14",
		"typescript": "~5.9.3",
		"vite": "^7.2.4",
		"vitest": "^4.0.18"
	}
}
